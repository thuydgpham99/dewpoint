# Copy to .env and fill in. Never commit the real .env.
#
# The app looks for .env in this order:
#   1. the repo folder
#   2. one level above the repo folder   <-- teaching staff keep theirs here
#   3. two levels above (local convenience only)

# Course key -- required.
PORTKEY_API_KEY=

# Optional. Defaults are shown; set them only to override.
# The course sets the model here, so the app follows it rather than hardcoding.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-5.6-luna

# Only needed if you swap to an OpenAI model directly. Optional.
OPENAI_API_KEY=
